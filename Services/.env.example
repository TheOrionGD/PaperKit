# PaperKit Backend Environment Variables
# Copy to .env and fill in your values

# MongoDB Atlas
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
DATABASE_NAME=paperkit

# JWT
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google Gemini AI (backend-mediated, never exposed to frontend)
GEMINI_API_KEY=your-gemini-api-key


# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:5173

# LibreOffice path (for document conversion)
LIBREOFFICE_PATH=libreoffice

# Tesseract path
TESSERACT_CMD=tesseract


