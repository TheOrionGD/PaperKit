# PaperKit Backend Environment Variables
# Copy to .env and fill in your values

# MongoDB Atlas
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
DATABASE_NAME=paperkit

# JWT
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Providers (Google Gemini / Groq)
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# Frontend URL (for OAuth redirects & CORS)
FRONTEND_URL=https://paperkit-web.onrender.com